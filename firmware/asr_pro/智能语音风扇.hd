/* =========================================================================
 * 8x8 双点阵表情屏驱动配置 (两块 MAX7219 级联，一只点阵显示一只眼睛)
 * 硬件接线参考（三根信号线连在一起，最方便插线）：
 *   点阵1 VCC  -> ASR-PRO 5V / VIN (必须接 5V，严禁接 3.3V)
 *   点阵1 GND  -> ASR-PRO GND
 *   点阵1 CLK  -> ASR-PRO PA0 (P2 排针从上往下第 5 脚，纯净 GPIO)
 *   点阵1 DIN  -> ASR-PRO PA5 (引脚 5，数据线)
 *   点阵1 CS   -> ASR-PRO PA6 (引脚 6，片选线)
 * 级联接线（串联）：
 *   点阵1 DOUT -> 点阵2 DIN (必须接在点阵2输入端 DIN，不能接点阵2的 DOUT)
 *   点阵1 CLK  -> 点阵2 CLK
 *   点阵1 CS   -> 点阵2 CS
 *   点阵1 VCC  -> 点阵2 VCC
 *   点阵1 GND  -> 点阵2 GND
 * ========================================================================= */
#define MATRIX_CLK_PIN        0   /* ASR-PRO PA0 (P2排针从上往下第5脚)，时钟线（已实测） */
#define MATRIX_DIN_PIN        5   /* ASR-PRO PA5 (P1排针从上往下第2脚，数据线) */
#define MATRIX_CS_PIN         6   /* ASR-PRO PA6 (P1排针最上方第1脚，片选线) */
/* PA4 已彻底弃用：它是 PG_EN 烧录使能脚，板载 D4 红 LED + 3.3k 上拉 + CH340 DTR 三极管 Q2，
   任何高电平翻转都可能触发编程模式，因此本文件不再引用 PA4。 */
#define MATRIX_CLK_PIN_PC4    20  /* ASR-PRO PC4 (P2排针从上往下第3脚，时钟备用) */

#define EYE_LEFT_IS_MODULE_1  1   /* 1: 点阵1显示左眼，点阵2显示右眼; 0: 反之 */
#define EYE_ROTATE_180        0   /* 1: 点阵上下倒置修正 (旋转180度); 0: 正常方向 */

typedef enum {
    EYE_EMOTION_NORMAL = 0,    /* 常态：明亮大眼，带高光，每 3 秒自然眨眼一次 */
    EYE_EMOTION_HAPPY,         /* 欢喜笑眼 ^^ (开机、清凉吹风、收到指令) */
    EYE_EMOTION_SLEEP,         /* 安睡闭眼 -- (关机、睡眠模式) */
    EYE_EMOTION_WINK,          /* 俏皮眨单眼 ^_- (唤醒反馈、小提示) */
    EYE_EMOTION_LOOK_LEFT,     /* 向左看 (摆头向左) */
    EYE_EMOTION_LOOK_RIGHT,    /* 向右看 (摆头向右) */
    EYE_EMOTION_SURPRISED,     /* 惊讶圆眼 OO (极速劲风、高温提醒) */
    EYE_EMOTION_HEART,         /* 爱心萌眼 <3 (表扬夸奖) */
    EYE_EMOTION_DIZZY          /* 眩晕旋转眼 @ @ (调速切换) */
} eye_emotion_t;

volatile eye_emotion_t g_eye_emotion = EYE_EMOTION_NORMAL;
volatile uint32_t g_emotion_expire_time = 0;
volatile bool g_fan_swinging = false;

